{{ 'sway.css' | asset_url | stylesheet_tag }}

<footer class="sway-footer">
  <div class="sway-footer__inner">
    <div class="sway-footer__brand">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 120 }}" alt="{{ shop.name }}" class="sway-footer__logo">
      {%- else -%}
        <img src="{{ 'sway-mark.svg' | asset_url }}" alt="{{ shop.name }}" class="sway-footer__mark">
        <span class="sway-footer__wordmark">SWAY</span>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="sway-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'link_column' -%}
        <div {{ block.shopify_attributes }}>
          <div class="sway-footer__col-title">{{ block.settings.title }}</div>
          <div class="sway-footer__col-links">
            {%- if block.settings.link_1_label != blank -%}<a href="{{ block.settings.link_1_url | default: '#' }}">{{ block.settings.link_1_label }}</a>{%- endif -%}
            {%- if block.settings.link_2_label != blank -%}<a href="{{ block.settings.link_2_url | default: '#' }}">{{ block.settings.link_2_label }}</a>{%- endif -%}
            {%- if block.settings.link_3_label != blank -%}<a href="{{ block.settings.link_3_url | default: '#' }}">{{ block.settings.link_3_label }}</a>{%- endif -%}
            {%- if block.settings.link_4_label != blank -%}<a href="{{ block.settings.link_4_url | default: '#' }}">{{ block.settings.link_4_label }}</a>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="sway-footer__bottom">
    <span>{{ section.settings.copyright | default: '© 2026 Sway Labs Inc.' }}</span>
    <span>
      {%- if section.settings.privacy_label != blank -%}
        <a href="{{ section.settings.privacy_url | default: '/policies/privacy-policy' }}">{{ section.settings.privacy_label }}</a>
        &nbsp;·&nbsp;
      {%- endif -%}
      {%- if section.settings.terms_label != blank -%}
        <a href="{{ section.settings.terms_url | default: '/policies/terms-of-service' }}">{{ section.settings.terms_label }}</a>
      {%- endif -%}
    </span>
  </div>
</footer>

<style>
  .sway-footer { background: var(--ink); color: var(--sand-50); padding: 64px clamp(20px,5vw,48px) 40px; }
  .sway-footer__inner { max-width: var(--container-max); margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; }
  .sway-footer__brand { display: flex; flex-direction: column; }
  .sway-footer__brand > div, .sway-footer__brand > a { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .sway-footer__mark { width: 36px; height: 36px; }
  .sway-footer__wordmark { font-family: var(--font-display); font-weight: 800; font-size: 26px; letter-spacing: -0.04em; color: #fff; }
  .sway-footer__logo { max-height: 36px; width: auto; margin-bottom: 16px; }
  .sway-footer__tagline { font-size: 15px; color: var(--sand-400); max-width: 280px; line-height: 1.6; margin: 0; }
  .sway-footer__col-title { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--sand-500); margin-bottom: 16px; }
  .sway-footer__col-links { display: flex; flex-direction: column; gap: 12px; }
  .sway-footer__col-links a { font-size: 15px; color: var(--sand-200); text-decoration: none; }
  .sway-footer__col-links a:hover { color: #fff; }
  .sway-footer__bottom { max-width: var(--container-max); margin: 40px auto 0; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.12); display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 12px; color: var(--sand-500); }
  .sway-footer__bottom a { color: var(--sand-500); text-decoration: none; }
  .sway-footer__bottom a:hover { color: var(--sand-200); }
  @media (max-width: 749px) { .sway-footer__inner { grid-template-columns: 1fr 1fr; } .sway-footer__brand { grid-column: 1 / -1; } }
</style>

{% schema %}
{
  "name": "Sway footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (optional — defaults to SVG mark)" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Smart glasses that train the mind. Built in California." },
    { "type": "text", "id": "copyright", "label": "Copyright line", "default": "© 2026 Sway Labs Inc." },
    { "type": "text", "id": "privacy_label", "label": "Privacy link label", "default": "Privacy" },
    { "type": "url", "id": "privacy_url", "label": "Privacy link URL" },
    { "type": "text", "id": "terms_label", "label": "Terms link label", "default": "Terms" },
    { "type": "url", "id": "terms_url", "label": "Terms link URL" }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "title", "label": "Column title", "default": "Product" },
        { "type": "text", "id": "link_1_label", "label": "Link 1 label", "default": "S1 Frames" },
        { "type": "url",  "id": "link_1_url",   "label": "Link 1 URL" },
        { "type": "text", "id": "link_2_label", "label": "Link 2 label", "default": "Lenses" },
        { "type": "url",  "id": "link_2_url",   "label": "Link 2 URL" },
        { "type": "text", "id": "link_3_label", "label": "Link 3 label", "default": "Accessories" },
        { "type": "url",  "id": "link_3_url",   "label": "Link 3 URL" },
        { "type": "text", "id": "link_4_label", "label": "Link 4 label" },
        { "type": "url",  "id": "link_4_url",   "label": "Link 4 URL" }
      ]
    }
  ],
  "presets": [{
    "name": "Sway footer",
    "blocks": [
      { "type": "link_column", "settings": { "title": "Product", "link_1_label": "S1 Frames", "link_2_label": "Lenses", "link_3_label": "Accessories", "link_4_label": "Compare" } },
      { "type": "link_column", "settings": { "title": "Company", "link_1_label": "Science", "link_2_label": "About", "link_3_label": "Careers", "link_4_label": "Press" } },
      { "type": "link_column", "settings": { "title": "Support", "link_1_label": "Help center", "link_2_label": "Warranty", "link_3_label": "Returns", "link_4_label": "Contact" } }
    ]
  }]
}
{% endschema %}
