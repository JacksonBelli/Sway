{{ 'sway.css' | asset_url | stylesheet_tag }}

<section class="sway-cta">
  <div class="sway-cta__inner">
    <h2 class="sway-cta__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="sway-btn" style="margin-top:36px;">{{ section.settings.button_label }}</a>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="sway-cta__sub">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .sway-cta { padding: clamp(64px,9vw,128px) clamp(20px,5vw,48px); text-align: center; }
  .sway-cta__inner { max-width: var(--container-max); margin: 0 auto; }
  .sway-cta__heading { font-size: clamp(2.4rem,6vw,4.5rem); font-weight: 900; letter-spacing: -0.035em; max-width: 760px; margin: 0 auto; }
  .sway-cta__sub { margin-top: 18px; font-family: var(--font-mono); font-size: 13px; color: var(--text-muted); }
  .sway-btn { display: inline-flex; align-items: center; height: 56px; padding: 0 30px; border-radius: var(--radius-pill); background: var(--accent); color: #fff; font-family: var(--font-display); font-weight: 600; font-size: 17px; text-decoration: none; box-shadow: var(--shadow-accent); transition: background var(--dur-fast) var(--ease-out); }
  .sway-btn:hover { background: var(--accent-hover); text-decoration: none; }
</style>

{% schema %}
{
  "name": "Sway CTA band",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your best thinking, on tap." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Sway S1 — $349" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "subtext", "label": "Subtext below button", "default": "Free shipping · 30-day returns · 2-year warranty" }
  ],
  "presets": [{ "name": "Sway CTA band" }]
}
{% endschema %}
